<Window x:Class="BeautyOfNumbers.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeautyOfNumbers.App.Wpf"
        xmlns:vm="clr-namespace:BeautyOfNumbers.App.Wpf.ViewModels"
        xmlns:controls="clr-namespace:BeautyOfNumbers.App.Wpf.Controls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Prime Spiral Visualizer" Height="700" Width="800"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="5"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="MinWidth" Value="100"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <TextBlock Grid.Row="0"
               Text="Prime Spiral Generator"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

    <!-- Range Input -->
    <Grid Grid.Row="1" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="Start:"
                 Grid.Row="0" Grid.Column="0"
                 ToolTip="First number in the range"/>

      <TextBox Width="100"
               Grid.Row="0" Grid.Column="1"
               Text="{Binding NumberRangeStart, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="First number in the range">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="Red"/>
                <Setter Property="BorderThickness" Value="2"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>

      <TextBlock Text="Number Count:"
                 Grid.Row="1" Grid.Column="0"
                 ToolTip="Enter a number between 10 and 100,000"/>

      <TextBox Width="100"
               Grid.Row="1" Grid.Column="1"
               Text="{Binding NumberRangeCount, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Enter a number between 10 and 100,000">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="Red"/>
                <Setter Property="BorderThickness" Value="2"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>

      <TextBlock Grid.Row="2" Grid.Column="1"
                 Text="{Binding ValidationMessage}"
                 Foreground="Red"
                 FontSize="12"
                 Margin="5,2"
                 Visibility="{Binding IsValid, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
    </Grid>

    <!-- Color Controls -->
    <Grid Grid.Row="2" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="Background Color:"
                 ToolTip="Choose the background color for the spiral"/>
      <xctk:ColorPicker Grid.Row="0" Grid.Column="1"
                        SelectedColor="{Binding BackgroundColor}"
                        Margin="5"/>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="Prime Numbers Color:"
                 ToolTip="Choose the color for prime numbers"/>
      <xctk:ColorPicker Grid.Row="1" Grid.Column="1"
                        SelectedColor="{Binding PrimeColor}"
                        Margin="5"/>

      <TextBlock Grid.Row="2" Grid.Column="0"
                 Text="Other Numbers Color:"
                 ToolTip="Choose the color for non-prime numbers"/>
      <xctk:ColorPicker Grid.Row="2" Grid.Column="1"
                        SelectedColor="{Binding NonPrimeColor}"
                        Margin="5"/>

      <TextBlock Grid.Row="3" Grid.Column="0"
                 Text="Point Size:"
                 ToolTip="Adjust the size of points in the spiral"/>
      <Slider Grid.Row="3" Grid.Column="1"
              Minimum="1" Maximum="10"
              Value="{Binding PointSize}"
              TickFrequency="1"
              IsSnapToTickEnabled="True"
              Margin="5"/>
    </Grid>

    <!-- Filters -->
    <CheckBox Grid.Row="3"
              Content="Show only primes"
              IsChecked="{Binding ShowOnlyPrimes}"
              HorizontalAlignment="Center"
              ToolTip="Render only prime numbers; composite numbers are skipped"/>

    <!-- Buttons -->
    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Center">
      <Button Content="Save Image"
              Command="{Binding SaveCommand}"
              ToolTip="Save the current spiral as an image file"/>
      <Button Content="Cancel"
              Command="{Binding CancelCommand}"
              ToolTip="Cancel the running render"/>
    </StackPanel>

    <!-- Progress Bar -->
    <Grid Grid.Row="5" Margin="10,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                   Height="20"
                   Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding ProgressStage}"
                 Margin="5,0,0,0"
                 VerticalAlignment="Center"
                 Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>

    <!-- Skia Live Preview -->
    <Border Grid.Row="6"
            BorderBrush="Gray"
            BorderThickness="1">
      <controls:SpiralPreviewControl x:Name="Preview"
                                      Scene="{Binding Scene, Mode=OneWay}"
                                      CurrentStyle="{Binding CurrentStyle}"/>
    </Border>
  </Grid>
</Window>