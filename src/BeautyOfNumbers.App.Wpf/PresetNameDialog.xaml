<Window x:Class="BeautyOfNumbers.App.Wpf.PresetNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Preset"
        Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Preset name:" Margin="0,0,0,5"/>
      <TextBox x:Name="NameTextBox"
               MaxLength="80"
               TextChanged="OnNameChanged"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText"
               Grid.Row="1"
               Text="Name is required"
               Foreground="Red"
               Margin="0,5,0,0"
               Visibility="Collapsed"/>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,15,0,0">
      <Button Content="OK"
              IsDefault="True"
              MinWidth="80"
              Margin="0,0,8,0"
              Click="OnOkClick"/>
      <Button Content="Cancel"
              IsCancel="True"
              MinWidth="80"/>
    </StackPanel>
  </Grid>
</Window>
